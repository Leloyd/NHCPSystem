FLASK_ENV=development
FLASK_SECRET_KEY=replace-with-long-random-secret
SESSION_COOKIE_SECURE=false

ADMIN_USERNAME=replace-admin-username
ADMIN_PASSWORD_HASH=replace-with-werkzeug-password-hash
ADMIN_SESSION_MINUTES=120
ADMIN_LOGIN_RATE_WINDOW_SECONDS=900
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCKOUT_SECONDS=900
TRUST_PROXY_HEADERS=false

# Optional WebXR runtime overrides
# MARBLE_ZIP_PATH=webxr_runtime/church.zip
# DEFAULT_QUALITY=auto
# DEBUG_COLLISION=false
